{
  "name": "Codex",

  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },

  // No platform override – let Docker use linux/amd64 like the host
  // "runArgs": ["--platform=linux/arm64"],  // ❌ remove this

  "containerEnv": {
    "RUST_BACKTRACE": "1",
    "CARGO_TARGET_DIR": "${containerWorkspaceFolder}/codex-rs/target-arm64"
  },

  // Let the Dockerfile's USER ubuntu stand, don't try to UID-mutate a second image
  "updateRemoteUserUID": false,
  "remoteUser": "ubuntu",

  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      },
      "extensions": [
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml"
      ]
    }
  }
}
