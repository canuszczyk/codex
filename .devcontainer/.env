# GitHub CLI token (for gh API; git over SSH uses your SSH key)
GH_TOKEN=

# AI keys (only if you actually use them in this container)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# NuGet tweaks for the devcontainer image
NUGET_PACKAGES=/home/vscode/.nuget/packages
NUGET_HTTPRETRY=8
NUGET_TIMEOUT=120
DOTNET_SYSTEM_NET_HTTP_SOCKETSHTTPHANDLER_HTTP2SUPPORT=false

# Optional ElevenLabs defaults
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
